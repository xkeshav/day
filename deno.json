{
  "name": "@xkeshav/day",
  "version": "1.1.1",
  "exports": "./index.ts",
  "imports": {
    "@xkeshav/day": "jsr:@xkeshav/day@1.1.1"
  },
  "tasks": {
    "dev": "deno run --watch index.ts",
    "server": "deno run -A server.ts"
  },
  "compilerOptions": {
    "strict": true,
    "checkJs": true,
    "lib": ["esnext", "dom", "deno.ns"]
  },
  "fmt": {
    "useTabs": true,
    "lineWidth": 80,
    "indentWidth": 4,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "include": ["src/"],
    "exclude": ["src/fixtures/**/*.ts"]
  }
}
